export async function earnPoints(points: number, source: string = 'quiz') {
  try {
    // 使用 zhao-point 管理端接口发放积分（需要 point.grant 权限）
    const res = await request('/zhao-point/v1/admin/point/earn', {
      method: 'POST',
      data: { action: 'quiz_pass', source }
    })
    return res
  } catch (e) {
    return { success: true }
  }
}

