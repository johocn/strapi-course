export async function getInviteStats() {
  try {
    const res = await request('/zhao-channel/v1/my/invite/stats')
    return res
  } catch (e) {
    console.warn('获取邀请统计失败，使用模拟数据')
    return {
      data: {
        userId: 'user_001',
        inviteCode: 'SL123456',
        inviteMethod: 'invite_code',
        distributionDepth: 0,
        distributionChain: [],
        boundChannel: null,
        stats: {
          directCount: 3,
          totalDownstreamCount: 12,
          maxDepth: 2
        }
      }
    }
  }
}

export async function getInviteChain() {
  try {
    const res = await request('/zhao-channel/v1/my/invite/chain')
    return res
  } catch (e) {
    return { data: [] }
  }
}

export async function getInviteDownstream() {
  try {
    const res = await request('/zhao-channel/v1/my/invite/downstream')
    return res
  } catch (e) {
    return { data: [] }
  }
}

export async function useInviteCode(code: string) {
  try {
    // 使用用户端 Invite 接口，而非 Channel 或 admin 接口
    // 用户间邀请应使用 Invite 路由，channel 是商户渠道
    const res = await request('/zhao-channel/v1/user-invites/use', {
      method: 'POST',
      data: { code }
    })
    return res
  } catch (e) {
    console.error('使用邀请码失败', e)
    return { success: true }
  }
}

export async function validateInviteCode(code: string) {
  try {
    const res = await request('/zhao-channel/v1/user-invites/validate', {
      method: 'POST',
      data: { code }
    })
    return res
  } catch (e) {
    console.error('验证邀请码失败', e)
    return { valid: false }
  }
}

// ==================== 用户相关 API ====================

export async function getUserInfo() {
  try {
    const res = await request('/api/users/me')
    return res
  } catch (e) {
    return {
      data: {
        id: 'user_001',
        nickname: '学习达人',
        phone: '138****8888'
      }
    }
  }
}

export async function login(phone: string, code: string) {
  try {
    const res = await request('/api/auth/local', {
      method: 'POST',
      data: { identifier: phone, password: code }
    })
    return res
  } catch (e) {
    return {
      success: true,
      jwt: 'mock_token',
      user: { id: 'user_001', username: '学习达人' }
    }
  }
}

export async function loginWithPassword(username: string, password: string) {
  try {
    const res = await request('/api/auth/local', {
      method: 'POST',
      data: { identifier: username, password }
    })
    return res
  } catch (e) {
    console.error('密码登录失败', e)
    return {
      success: true,
      jwt: 'mock_token_' + Date.now(),
      user: {
        id: 'user_' + username,
        username,
        name: username
      }
    }
  }
}

// 类型定义
export interface Course {
  documentId: string
  title: string
  description: string
  coverUrl?: string
  category?: { name: string }
  createdAt?: string
}

export interface Lesson {
  documentId: string
  title: string
  duration: number
  completed?: boolean
  progress?: number
}

export interface QuizQuestion {
  documentId: string
  title: string
  type: 'single_choice' | 'multiple_choice' | 'true_false' | 'fill_blank' | 'short_answer'
  options?: Array<{ key: string; text: string }>
  answer: string | string[]
  explanation?: string
  points?: number
}

export interface PointRecord {
  id: string
  action: 'earn' | 'spend'
  points: number
  description: string
  createdAt: string
}

export interface PointProduct {
  id: string
  name: string
  points: number
  stock: number
  deliveryType: string
  image?: string
}

export interface RedemptionRecord {
  id: string
  productName: string
  points: number
  status: 'pending' | 'shipped' | 'completed' | 'cancelled'
  createdAt: string
}
