    return res
  } catch (e) {
    return {
      data: [
        { 
          documentId: 'q1', 
          title: '以下哪个是正确的问候语？', 
          type: 'single_choice', 
          options: [
            { key: 'A', text: 'Hello' },
            { key: 'B', text: 'Goodbye' },
            { key: 'C', text: 'Thank you' },
            { key: 'D', text: 'Sorry' }
          ], 
          answer: 'A', 
          explanation: 'Hello 是标准的英语问候语', 
          points: 10 
